{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradekit-lite",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "none"
  }
}
