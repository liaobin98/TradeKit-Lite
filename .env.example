# Public site URL used only at build time; leave empty for an unindexed preview.
# Set your own HTTPS origin before publishing; no paths or query parameters.
SITE_URL=
# Set false for preview builds, even when SITE_URL points to the public site.
SITE_INDEXABLE=true
PORT=3001
HOST=127.0.0.1
# Comma-separated exact frontend origins; set when using an HTTPS reverse proxy.
# This is a CSRF check, not authentication. Cross-origin deployment is not supported.
ALLOWED_ORIGINS=
# OpenAI-compatible endpoint. Keys stay on server only.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Required for online AI. Random token: 32-512 non-space printable ASCII chars.
# Separate from AI_API_KEY; users enter it in the page, never in VITE_ variables.
AI_ACCESS_TOKEN=
# Best-effort PER-INSTANCE limits, not distributed/user quotas or a spending cap.
AI_RATE_LIMIT=10
AI_MAX_CONCURRENT=2
AI_MAX_TOKENS=2048
# Public exchange data; override with a compatible open.er-api response endpoint.
EXCHANGE_URL=https://open.er-api.com/v6/latest/USD
