{
  "name": "tradekit-lite",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server.mjs",
    "start": "node server.mjs --production",
    "licenses": "node scripts/licenses.mjs",
    "prebuild": "npm run licenses",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:deployment": "node scripts/deployment-smoke.mjs",
    "test:seo": "node scripts/site-build-smoke.mjs",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "check:cloudflare": "wrangler deploy --dry-run --outdir test-artifacts/cloudflare-worker",
    "test:cloudflare": "node scripts/cloudflare-smoke.mjs",
    "test:documents": "node scripts/multi-documents-smoke.mjs",
    "test:editing": "node scripts/document-editing-smoke.mjs",
    "test:recovery": "node scripts/recovery-export-smoke.mjs",
    "test:navigation": "node scripts/mobile-navigation-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "check:repository": "node scripts/check-repository.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.3",
    "wrangler": "4.149.0"
  }
}
